@model PortfolioTracker.Models.Asset

@{
    ViewData["Title"] = "Delete Asset";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-lg border-danger" style="border-radius: 12px;">
                <div class="card-header bg-danger text-white" style="border-radius: 12px 12px 0 0; border: none;">
                    <h3 class="mb-0"><i class="bi bi-trash"></i> @ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Warning!</strong> This action cannot be undone. All data will be permanently deleted.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>

                    <div class="info-section mb-4 p-3 bg-light rounded">
                        <h5 class="text-primary mb-3"><i class="bi bi-info-circle"></i> Asset Details</h5>
                        <dl class="row mb-0">
                            <dt class="col-sm-3"><i class="bi bi-coin"></i> Symbol</dt>
                            <dd class="col-sm-9"><span class="badge bg-info fs-6">@Model.Symbol</span></dd>

                            <dt class="col-sm-3"><i class="bi bi-percent"></i> Quantity</dt>
                            <dd class="col-sm-9"><strong>@Model.Quantity.ToString("F4")</strong></dd>

                            <dt class="col-sm-3"><i class="bi bi-currency-dollar"></i> Current Value</dt>
                            <dd class="col-sm-9"><strong class="text-danger">$@Model.CurrentValue.ToString("F2")</strong></dd>

                            <dt class="col-sm-3"><i class="bi bi-calendar"></i> Purchase Date</dt>
                            <dd class="col-sm-9">@Model.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are you absolutely sure you want to delete this asset? This cannot be undone!');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-check-circle"></i> Yes, Delete Permanently
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
