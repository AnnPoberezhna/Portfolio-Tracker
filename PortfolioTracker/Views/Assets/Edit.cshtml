@model PortfolioTracker.Models.Asset

@{
    ViewData["Title"] = "Edit Asset";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-lg" style="border: none; border-radius: 12px;">
                <div class="card-header bg-warning text-dark" style="border-radius: 12px 12px 0 0; border: none;">
                    <h3 class="mb-0"><i class="bi bi-pencil-square"></i> @ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span asp-validation-summary="All"></span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <input asp-for="Id" type="hidden" />

                        <div class="mb-4">
                            <label asp-for="Symbol" class="form-label"><i class="bi bi-coin"></i> Cryptocurrency</label>
                            <input asp-for="Symbol" class="form-control form-control-lg" list="cryptos" placeholder="🔍 Start typing to search..." />
                            <datalist id="cryptos">
                                @foreach (var crypto in ViewBag.Cryptocurrencies ?? new List<dynamic>())
                                {
                                    <option value="@crypto.Value">@crypto.Text</option>
                                }
                            </datalist>
                            <span asp-validation-for="Symbol" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Quantity" class="form-label"><i class="bi bi-plus-square"></i> Quantity</label>
                            <input asp-for="Quantity" class="form-control form-control-lg" step="0.0001" type="number" />
                            <span asp-validation-for="Quantity" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PurchaseDate" class="form-label"><i class="bi bi-calendar-event"></i> Purchase Date</label>
                            <input asp-for="PurchaseDate" class="form-control form-control-lg" type="datetime-local" min="1900-01-01T00:00" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="PurchaseDate" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="d-flex gap-3 pt-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-arrow-repeat"></i> Update Asset
                            </button>
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
