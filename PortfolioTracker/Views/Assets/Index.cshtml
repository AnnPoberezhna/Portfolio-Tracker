@model IEnumerable<PortfolioTracker.Models.AssetViewModel>

@{
    ViewData["Title"] = "My Assets";
}

<div class="container mt-4">
    <div class="row mb-5">
        <div class="col-md-8">
            <div>
                <h1 class="display-5" style="font-weight: 700; color: #2c3e50;">
                    <i class="bi bi-wallet2" style="color: #0d6efd;"></i> My Assets
                </h1>
                <p class="text-muted">Manage and track all your cryptocurrency holdings</p>
            </div>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success btn-lg">
                <i class="bi bi-plus-circle"></i> Add New Asset
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row mb-4">
            <div class="col-md-12">
                <form method="get" class="input-group input-group-lg">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search" style="color: #666;"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" placeholder="Search by symbol or name..." name="searchSymbol" value="@ViewBag.SearchSymbol">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-funnel"></i> Search
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="bi bi-x"></i> Clear
                    </a>
                </form>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><i class="bi bi-coin"></i> Symbol</th>
                        <th><i class="bi bi-percent"></i> Quantity</th>
                        <th><i class="bi bi-graph-up"></i> Current Price</th>
                        <th><i class="bi bi-cash-coin"></i> Current Value</th>
                        <th><i class="bi bi-calendar"></i> Purchase Date</th>
                        <th style="text-align: center;"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-info text-white" style="font-size: 0.95rem; padding: 0.6rem 0.8rem;">
                                    <i class="bi bi-coin"></i> @item.Symbol
                                </span>
                            </td>
                            <td>
                                <strong>@item.Quantity.ToString("F4")</strong>
                            </td>
                            <td class="price-cell @item.PriceChangeClass" data-symbol="@item.Symbol" data-current="@item.CurrentPrice" data-previous="@item.PreviousPrice">
                                <span style="font-weight: 600;">$@item.CurrentPrice.ToString("F2")</span>
                            </td>
                            <td>
                                <strong style="color: #0d6efd; font-size: 1.05rem;">$@item.CurrentValue.ToString("F2")</strong>
                            </td>
                            <td>
                                <i class="bi bi-calendar-event" style="color: #666;"></i>
                                @item.PurchaseDate.ToString("yyyy-MM-dd")
                            </td>
                            <td style="text-align: center;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit Asset">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete Asset">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>No assets yet!</strong> Start building your portfolio by adding your first cryptocurrency asset.
            <a asp-action="Create" class="alert-link fw-bold">Add your first asset →</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</div>

<style>
    .price-cell {
        transition: background-color 1s ease, color 1s ease;
    }

    .price-up {
        background-color: #d4edda;
        color: #155724;
        font-weight: bold;
    }

    .price-down {
        background-color: #f8d7da;
        color: #721c24;
        font-weight: bold;
    }
</style>

@section Scripts {
    <script>
        // Auto-refresh prices every 20 seconds
        setInterval(async function () {
            location.reload();
        }, 20000);

        // Trigger animation on page load for any price changes
        document.addEventListener('DOMContentLoaded', function () {
            const priceCells = document.querySelectorAll('.price-cell');
            priceCells.forEach(cell => {
                const current = parseFloat(cell.getAttribute('data-current'));
                const previous = parseFloat(cell.getAttribute('data-previous'));
                let animationClass = '';

                if (previous > 0) {
                    if (current > previous) {
                        animationClass = 'price-up';
                    } else if (current < previous) {
                        animationClass = 'price-down';
                    }
                }

                if (animationClass) {
                    // Force a reflow before adding the animation class so the animation plays reliably.
                    void cell.offsetWidth;
                    cell.classList.add(animationClass);

                    setTimeout(() => {
                        cell.classList.remove(animationClass);
                    }, 1200);
                }
            });
        });
    </script>
}

